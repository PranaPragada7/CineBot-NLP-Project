# Optional. CineBot uses its built-in catalog when this is blank.
TMDB_API_KEY=

# Used by the Streamlit frontend. The default is http://127.0.0.1:8000.
CINEBOT_API_URL=http://127.0.0.1:8000

# Local default is SQLite. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite+pysqlite:///./data/cinebot.db
AUTO_CREATE_SCHEMA=false

# Optional locally. Production uses Redis; without it, a process-local limiter is used.
REDIS_URL=
REQUIRE_REDIS=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO
